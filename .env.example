# Path to OAuth 2.0 client_secret.json downloaded from Google Cloud Console
# Default: ~/.youtube-mcp/client_secret.json
YOUTUBE_MCP_CLIENT_SECRET=

# Directory for storing token.json, quota.json, and accounts/<name>/ profiles
# Default: ~/.youtube-mcp
YOUTUBE_MCP_CONFIG_DIR=

# Active account profile name: "default" or any named account under accounts/
YOUTUBE_MCP_ACCOUNT=default

# OAuth scope profile: "full" (default), "upload_only", or "read_only"
YOUTUBE_MCP_SCOPE_PROFILE=full

# Optional: restrict video/thumbnail uploads to files inside this directory
# Leave empty to allow any readable local file path
YOUTUBE_MCP_ALLOWED_MEDIA_DIR=

# Optional: daily YouTube Data API v3 quota limit (default: 10000)
YOUTUBE_MCP_DAILY_QUOTA=10000

# Optional: API key for public-only lookups without OAuth
YOUTUBE_API_KEY=
